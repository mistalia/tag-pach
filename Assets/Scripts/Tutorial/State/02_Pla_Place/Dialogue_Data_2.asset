  - speakerName: "\u30B3\u30DE\u30CE\u30B3"
    message: "\u30C7\u30D0\u30A4\u30B9\u306F\u8A18\u61B6\u62C5\u5F53\u306A\u30CE\u30C0\u3002\n\u3069\u3053\u306B\u3069\u3063\u3061\u306E\u99D2\u304C\u3042\u308B\u304B\u8A18\u61B6\u3057\u3066\u3001\u4EBA\u9593\u5074\u306B\u3084\u308A\u305F\u3044\u3053\u3068\u3092\u4F1D\u3048\u308B\u30CE\u30C0\uFF01"
