  - speakerName: "\u30B3\u30DE\u30CE\u30B3"
    message: "\u7F6E\u304B\u308C\u305F\u99D2\u306F\u30DC\u30AF\u3068\u540C\u3058\u898B\u305F\u76EE\u306B\u306A\u308B\u30CE\u30C0\u3002"
